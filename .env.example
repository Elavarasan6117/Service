# =============================================================================
# Chennai Serviceability Platform — environment template
# Copy to .env and fill in. NEVER commit .env.
# =============================================================================

ENVIRONMENT=development           # development | qa | uat | production
DEBUG=true
LOG_LEVEL=INFO
LOG_FORMAT=json                   # json | console
APP_NAME="Chennai Serviceability Operations"
API_V1_PREFIX=/api/v1
ENABLE_API_DOCS=true              # MUST be false in production

# --- Security -----------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_generate_a_64_char_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
TRUSTED_HOSTS=localhost,127.0.0.1
FORCE_HTTPS=false                 # true in production

# Bootstrap admin, created by `make seed` if absent.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=ops@example.com
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_before_first_run

# --- Database -----------------------------------------------------------
POSTGRES_USER=serviceability
POSTGRES_PASSWORD=CHANGE_ME_db_password
POSTGRES_DB=serviceability
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# --- Redis --------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- Providers ----------------------------------------------------------
# google_maps | osrm | fake
ROUTING_PROVIDER=google_maps
# google_maps | nominatim | photon | fake
# Without a Google key, use photon (Komoot's public instance) rather than
# nominatim directly -- same OSM data, but built for application traffic; the
# raw osm.org Nominatim endpoint's usage policy blocks anything beyond very
# light manual use.
GEOCODING_PROVIDER=google_maps
ROUTING_FALLBACK_PROVIDER=         # optional, e.g. osrm

# SERVER-SIDE ONLY. Never expose to the browser.
# Restrict by IP in Google Cloud Console and enable only:
# Geocoding API, Places API, Distance Matrix API, Directions API.
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_REGION=in
GOOGLE_MAPS_LANGUAGE=en
GOOGLE_PLACES_COUNTRY_FILTER=in

# Self-hosted OSRM (used when ROUTING_PROVIDER=osrm or as fallback)
OSRM_BASE_URL=http://osrm:5000

# Resilience
PROVIDER_TIMEOUT_SECONDS=8
PROVIDER_MAX_RETRIES=3
PROVIDER_BACKOFF_BASE_SECONDS=0.5
PROVIDER_CIRCUIT_FAIL_THRESHOLD=5
PROVIDER_CIRCUIT_RESET_SECONDS=60

# --- Serviceability defaults --------------------------------------------
# These SEED app_config on first migration. After that the DATABASE is the
# source of truth and these values are ignored — change them in the admin UI.
DEFAULT_SERVICEABILITY_RADIUS_METERS=2000
DEFAULT_CANDIDATE_RADIUS_FACTOR=4.0
DEFAULT_CANDIDATE_MAX_COUNT=10
DEFAULT_ROUTE_CACHE_TTL_SECONDS=86400

# --- Map ----------------------------------------------------------------
MAP_DEFAULT_CENTER_LAT=13.0827
MAP_DEFAULT_CENTER_LNG=80.2707
MAP_DEFAULT_ZOOM=12
MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors

# --- Rate limiting ------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_PER_MINUTE=300
RATE_LIMIT_CHECK_PER_MINUTE=60
RATE_LIMIT_AUTOCOMPLETE_PER_MINUTE=120
RATE_LIMIT_LOGIN_PER_15MIN=5

# --- Observability ------------------------------------------------------
METRICS_ENABLED=true
SENTRY_DSN=

# --- Frontend build-time (VITE_ vars are PUBLIC — no secrets here) -------
VITE_API_BASE_URL=/api/v1
